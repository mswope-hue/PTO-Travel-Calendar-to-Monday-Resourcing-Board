# Azure AD app registration (needs Calendars.Read application permission)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret

# Email address of the mailbox whose Travel calendar to monitor
OUTLOOK_USER_EMAIL=calendar-owner@yourdomain.com

# Monday.com
MONDAY_API_KEY=your-monday-api-key
# Resourcing Board ID (default is the live board)
MONDAY_BOARD_ID=18397329110

# How many hours back to look for new events when running in poll mode (default 25)
LOOKBACK_HOURS=25

# Webhook mode: secret used to validate MS Graph change notifications
WEBHOOK_SECRET=your-random-secret-string
# Port for the webhook listener (default 5000)
WEBHOOK_PORT=5000
